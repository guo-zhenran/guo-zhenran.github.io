---
layout: default
---

{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post misc-page">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}
  </header>

  <div class="misc-card-grid" aria-label="Misc sections">
    <button class="misc-card" type="button" data-misc-target="references" aria-haspopup="dialog">
      <span class="misc-card__top">
        <span class="misc-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M7 3.5h7l4 4V20H7z"></path>
            <path d="M14 3.5V8h4M10 12h5M10 15h5"></path>
          </svg>
        </span>
        <span class="misc-card__arrow" aria-hidden="true">↗</span>
      </span>
      <span class="misc-card__title">References</span>
    </button>
    <button class="misc-card" type="button" data-misc-target="people" aria-haspopup="dialog">
      <span class="misc-card__top">
        <span class="misc-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="9" cy="8.5" r="3"></circle>
            <path d="M4.5 19.5c.4-4 2-6 4.5-6s4.1 2 4.5 6M15 5.8a3 3 0 0 1 0 5.4M16.5 14c2.2.4 3.4 2.3 3.7 5.5"></path>
          </svg>
        </span>
        <span class="misc-card__arrow" aria-hidden="true">↗</span>
      </span>
      <span class="misc-card__title">People</span>
    </button>
    <button class="misc-card" type="button" data-misc-target="favorites" aria-haspopup="dialog">
      <span class="misc-card__top">
        <span class="misc-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"></path>
          </svg>
        </span>
        <span class="misc-card__arrow" aria-hidden="true">↗</span>
      </span>
      <span class="misc-card__title">Favorites</span>
    </button>
    <button class="misc-card" type="button" data-misc-target="materials" aria-haspopup="dialog">
      <span class="misc-card__top">
        <span class="misc-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M3.5 6.5h6l2 2h9V19h-17z"></path>
            <path d="M3.5 10h17"></path>
          </svg>
        </span>
        <span class="misc-card__arrow" aria-hidden="true">↗</span>
      </span>
      <span class="misc-card__title">Materials</span>
    </button>
  </div>
</div>

<dialog class="misc-dialog" id="misc-dialog" aria-label="Misc details">
  <button class="misc-dialog__close" type="button" aria-label="Close">&times;</button>
  <div class="misc-dialog__body">
    <section class="misc-panel" data-misc-panel="references">
      <header class="misc-panel__header">
        <p class="misc-panel__eyebrow">01 / Misc</p>
        <h2>References</h2>
      </header>
      <div class="reference-list">
        {% for reference in page.references %}
          <article class="reference">
            <div>
              <h3 class="reference__name">
                {% if reference.homepage %}
                  <a href="{{ reference.homepage }}" target="_blank" rel="noopener noreferrer">{{ reference.name }}</a>
                {% else %}
                  {{ reference.name }}
                {% endif %}
              </h3>
              {% if reference.context %}<p class="reference__context">{{ reference.context }}</p>{% endif %}
            </div>
            <div class="reference__details">
              <p>{{ reference.title }}</p>
              <p>{{ reference.affiliation }}</p>
              <p>
                {% if reference.email contains "@" %}
                  <a href="mailto:{{ reference.email }}">{{ reference.email }}</a>
                {% else %}
                  <span class="misc-muted">{{ reference.email }}</span>
                {% endif %}
              </p>
            </div>
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="misc-panel" data-misc-panel="people" hidden>
      <header class="misc-panel__header">
        <p class="misc-panel__eyebrow">02 / Misc</p>
        <h2>People</h2>
        <p>Soulmate, mentors, and co-authors.</p>
      </header>
      <div class="people-content">
        <section class="soulmate">
          <h3>Soulmate</h3>
          <p class="soulmate__sentence">{{ page.soulmate.sentence }}</p>
          <div class="soulmate__photos">
            {% for photo in page.soulmate.photos %}
              <figure class="soulmate-photo">
                <img src="{{ photo.image | relative_url }}" alt="{{ photo.note }}" loading="lazy">
                <figcaption>{{ photo.note }}</figcaption>
              </figure>
            {% endfor %}
          </div>
        </section>

        <div class="people-links">
          <section>
            <h3>Mentors</h3>
            <ul class="people-link-list">
              {% for mentor in page.mentors %}
                <li><a href="{{ mentor.website }}" target="_blank" rel="noopener noreferrer">{{ mentor.name }}</a></li>
              {% endfor %}
            </ul>
          </section>
          <section>
            <h3>Co-authors</h3>
            {% if page.coauthors and page.coauthors.size > 0 %}
              <ul class="people-link-list">
                {% for coauthor in page.coauthors %}
                  <li><a href="{{ coauthor.website }}" target="_blank" rel="noopener noreferrer">{{ coauthor.name }}</a></li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="people-empty">No co-authors listed yet.</p>
            {% endif %}
          </section>
        </div>
      </div>
    </section>

    <section class="misc-panel" data-misc-panel="favorites" hidden>
      <header class="misc-panel__header">
        <p class="misc-panel__eyebrow">03 / Misc</p>
        <h2>Favorites</h2>
        <p>Film, music, and the pen in hand.</p>
      </header>
      <div class="favorites-list">
        {% for favorite in page.favorites %}
          <article class="favorite">
            <p class="favorite__label">{{ favorite.label }}</p>
            <ul class="favorite__items">
              {% for item in favorite.items %}
                <li>
                  <span class="favorite__title">{{ item.title }}</span>
                  {% if item.by %}<span class="favorite__by">by {{ item.by }}</span>{% endif %}
                </li>
              {% endfor %}
            </ul>
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="misc-panel" data-misc-panel="materials" hidden>
      <header class="misc-panel__header">
        <p class="misc-panel__eyebrow">04 / Misc</p>
        <h2>Materials</h2>
        <p>Templates, reading lists, and unfinished work.</p>
      </header>
      <div class="materials-list">
        {% for material in page.materials %}
          <article class="material">
            <div>
              <h3 class="material__title">{{ material.title }}</h3>
              <p class="material__type">{{ material.type }}</p>
            </div>
            <p class="material__description">{{ material.description }}</p>
            <div class="material__links">
              {% if material.links and material.links.size > 0 %}
                {% for link in material.links %}
                  <a
                    href="{% if link.external %}{{ link.url }}{% else %}{{ link.url | relative_url }}{% endif %}"
                    {% if link.external %}target="_blank" rel="noopener noreferrer"{% endif %}
                  >{{ link.label }}</a>
                {% endfor %}
              {% else %}
                <span class="misc-muted">{{ material.status | default: "In progress" }}</span>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  </div>
</dialog>

<script>
  (() => {
    const cards = Array.from(document.querySelectorAll("[data-misc-target]"));
    const dialog = document.getElementById("misc-dialog");
    const panels = Array.from(document.querySelectorAll("[data-misc-panel]"));
    const closeButton = dialog.querySelector(".misc-dialog__close");
    if (!cards.length || !dialog || !closeButton) return;

    const openPanel = (target, opener) => {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.miscPanel !== target;
      });
      dialog.dataset.opener = opener.id || "";
      document.body.classList.add("misc-dialog-open");
      dialog.showModal();
      closeButton.focus();
    };

    cards.forEach((card) => {
      card.addEventListener("click", () => openPanel(card.dataset.miscTarget, card));
    });

    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      document.body.classList.remove("misc-dialog-open");
    });
  })();
</script>
